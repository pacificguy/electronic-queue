# Скопируйте в .env и при необходимости измените значения
POSTGRES_USER=queue
POSTGRES_PASSWORD=queue
POSTGRES_DB=queue

DATABASE_URL=postgresql+psycopg2://queue:queue@db:5432/queue
SECRET_KEY=please-change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=240

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator

DEMO_CLIENT_EMAIL=client@example.com
DEMO_CLIENT_PASSWORD=client12345
DEMO_CLIENT_NAME=Demo Client

UI_PORT=8080
API_PORT=8000
